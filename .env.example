# Runtime configuration for Le Kiosque. Copy this file to .env.local.
PORT=39014
APP_BASE_PATH=
JOURNAL_DB_PATH=./data/journal.sqlite
JOURNAL_STORAGE_DIR=./storage
DEFAULT_RSS_FEEDS=

# Optional: recovery password kept only on the server, never in Git.
GOD_ACCESS_PASSWORD=

# Maximum time allowed for one torrent client command, in seconds.
TORRENT_TIMEOUT_SECONDS=1800
